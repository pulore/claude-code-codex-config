prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Pushing leaves the machine. Ask first.",
    match = ["git push", "git push origin main"],
    not_match = ["git status"],
)

prefix_rule(
    pattern = [["codex", "claude"]],
    decision = "forbidden",
    justification = "Do not start another agent session from inside this one.",
)
