{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": ["Bash(npm run *)", "Bash(git diff *)", "Bash(git log *)"],
    "ask": [
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/.agents/skills/**)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(/.claude/settings.json)",
      "Edit(/.mcp.json)",
      "Edit(/.codex/**)",
      "Edit(/.agents/hooks/**)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": ["./.env"],
      "denyWrite": ["./.codex", "./.agents", "./.claude", "./.mcp.json"]
    },
    "network": { "allowedDomains": ["registry.npmjs.org"] }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/guard-bash.sh"
          }
        ]
      }
    ]
  }
}
